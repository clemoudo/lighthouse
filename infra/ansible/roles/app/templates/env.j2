# Production Environment Variables
NODE_ENV=production

BASE_DOMAIN={{ base_domain | default(lookup('env', 'BASE_DOMAIN'), true) }}
TRAEFIK_DASHBOARD_AUTH={{ traefik_dashboard_auth | default(lookup('env', 'TRAEFIK_DASHBOARD_AUTH'), true) }}

DB_USER={{ db_user | default(lookup('env', 'DB_USER'), true) }}
DB_PASSWORD={{ db_password | default(lookup('env', 'DB_PASSWORD'), true) }}
DB_NAME={{ db_name | default(lookup('env', 'DB_NAME'), true) }}

# Prisma DATABASE_URL (Constructed or from env)
DATABASE_URL={{ lookup('env', 'DATABASE_URL') | default('postgresql://' + (db_user | default(lookup('env', 'DB_USER'), true)) + ':' + (db_password | default(lookup('env', 'DB_PASSWORD'), true)) + '@postgres:5432/' + (db_name | default(lookup('env', 'DB_NAME'), true)), true) }}

NEXT_PUBLIC_API_URL={{ lookup('env', 'NEXT_PUBLIC_API_URL') | default('https://' + (base_domain | default(lookup('env', 'BASE_DOMAIN'), true)) + '/api', true) }}
API_HOST={{ lookup('env', 'API_HOST') | default('api') }}
API_PORT={{ lookup('env', 'API_PORT') | default('3001') }}
WEB_HOST={{ lookup('env', 'WEB_HOST') | default('web') }}
WEB_PORT={{ lookup('env', 'WEB_PORT') | default('3000') }}

# Infisical
INFISICAL_PROJECT_ID={{ infisical_project_id | default(lookup('env', 'INFISICAL_PROJECT_ID'), true) }}
INFISICAL_API_URL={{ infisical_api_url | default(lookup('env', 'INFISICAL_API_URL'), true) | default('https://eu.infisical.com/', true) }}

# Connection credentials for each service
INFISICAL_CLIENT_ID_WEB={{ infisical_client_id_web | default(lookup('env', 'INFISICAL_CLIENT_ID_WEB'), true) }}
INFISICAL_CLIENT_SECRET_WEB={{ infisical_client_secret_web | default(lookup('env', 'INFISICAL_CLIENT_SECRET_WEB'), true) }}
INFISICAL_CLIENT_ID_API={{ infisical_client_id_api | default(lookup('env', 'INFISICAL_CLIENT_ID_API'), true) }}
INFISICAL_CLIENT_SECRET_API={{ infisical_client_secret_api | default(lookup('env', 'INFISICAL_CLIENT_SECRET_API'), true) }}

# Docker Images
API_IMAGE={{ api_image | default('lighthouse-api:latest') }}
WEB_IMAGE={{ web_image | default('lighthouse-web:latest') }}
