# Production Environment Variables
NODE_ENV=production

BASE_DOMAIN={{ base_domain | default(lookup('env', 'INF_BASE_DOMAIN')) }}
TRAEFIK_DASHBOARD_AUTH='{{ traefik_dashboard_auth | default(lookup('env', 'INF_TRAEFIK_DASHBOARD_AUTH')) }}'

DB_USER={{ db_user | default(lookup('env', 'INF_DB_USER')) }}
DB_PASSWORD={{ db_password | default(lookup('env', 'INF_DB_PASSWORD')) }}
DB_NAME={{ db_name | default(lookup('env', 'INF_DB_NAME')) }}

NEXT_PUBLIC_API_URL={{ lookup('env', 'INF_NEXT_PUBLIC_API_URL') | default('https://' + (base_domain | default(lookup('env', 'INF_BASE_DOMAIN'))) + '/api', true) }}
API_HOST={{ lookup('env', 'INF_API_HOST') | default('api') }}
API_PORT={{ lookup('env', 'INF_API_PORT') | default('3001') }}
WEB_HOST={{ lookup('env', 'INF_WEB_HOST') | default('web') }}
WEB_PORT={{ lookup('env', 'INF_WEB_PORT') | default('3000') }}

# Infisical
INFISICAL_PROJECT_ID={{ infisical_project_id | default(lookup('env', 'INFISICAL_PROJECT_ID')) }}
INFISICAL_API_URL={{ infisical_api_url | default(lookup('env', 'INFISICAL_API_URL')) | default('https://app.infisical.com/api', true) }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID_WEB={{ infisical_client_id_web | default(lookup('env', 'INFISICAL_CLIENT_ID_WEB')) }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET_WEB={{ infisical_client_secret_web | default(lookup('env', 'INFISICAL_CLIENT_SECRET_WEB')) }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID_API={{ infisical_client_id_api | default(lookup('env', 'INFISICAL_CLIENT_ID_API')) }}
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET_API={{ infisical_client_secret_api | default(lookup('env', 'INFISICAL_CLIENT_SECRET_API')) }}

# Docker Images
API_IMAGE={{ api_image | default('lighthouse-api:latest') }}
WEB_IMAGE={{ web_image | default('lighthouse-web:latest') }}
