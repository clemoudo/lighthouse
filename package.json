{
  "name": "lighthouse",
  "version": "0.0.0",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "docker:dev": "infisical run --env=dev -- docker compose up -d",
    "docker:build-dev": "infisical run --env=dev -- docker compose build",
    "docker:stop": "infisical run --env=dev -- docker compose down",
    "docker:restart": "pnpm docker:stop && pnpm docker:dev",
    "docker:prod": "infisical run --env=prod -- docker compose -f docker-compose.yml up -d",
    "docker:build": "infisical run --env=prod -- docker compose -f docker-compose.yml build",
    "docker:logs": "docker compose logs -f",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "lint": "infisical run --env=dev -- turbo run lint",
    "lint:fix": "infisical run --env=dev -- turbo run lint:fix",
    "test": "infisical run --env=dev -- turbo run test",
    "tsc": "infisical run --env=dev -- turbo run tsc",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "provision": "cd infra/ansible && infisical run --env=prod -- ansible-playbook provision.yml",
    "deploy:prod": "cd infra/ansible && infisical run --env=prod -- ansible-playbook deploy.yml",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:reset": "pnpm --filter @repo/db db:reset",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:deploy": "pnpm --filter @repo/db db:deploy"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.6",
    "@repo/prettier-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-turbo": "^2.9.14",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
