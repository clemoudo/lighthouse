{
  "name": "lighthouse",
  "version": "0.0.0",
  "private": true,
  "prettier": "@repo/prettier-config",
  "scripts": {
    "build": "infisical run --env=prod -- turbo run build",
    "clean": "turbo run clean",
    "dev": "infisical run --env=dev -- turbo run dev",
    "docker:build": "infisical run --env=prod -- docker compose build",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\" . --list-different",
    "format:check": "turbo run format:check",
    "lint": "infisical run --env=dev -- turbo run lint",
    "test": "infisical run --env=dev -- turbo run test",
    "tsc": "infisical run --env=dev -- turbo run tsc",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@eslint/compat": "^2.0.3",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "9",
    "@next/eslint-plugin-next": "^16.1.6",
    "@repo/prettier-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "eslint": "^9.39.4",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-turbo": "^2.8.16",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "turbo": "^2.8.16",
    "typescript-eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1"
}
