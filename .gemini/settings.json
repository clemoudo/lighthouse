{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["next-devtools-mcp@latest"]
    },
    "heroui-react": {
      "command": "npx",
      "args": ["-y", "@heroui/react-mcp@latest"]
    },
    "better-auth": {
      "url": "https://mcp.better-auth.com/mcp"
    },
    "antd": {
      "command": "antd",
      "args": ["mcp"]
    }
  }
}
