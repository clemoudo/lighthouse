# Optimized pnpm configuration for Turborepo monorepo

# Hoist ESLint and Prettier plugins to the root node_modules.
# This allows shared configurations to find their plugins without 
# having to list them as 'dependencies' in the shared package.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@typescript-eslint/*

# Enforce the use of the correct pnpm version and prevent npm/yarn from running
engine-strict=true

# Ensure that we use a virtual store for better performance and space saving
virtual-store-dir=node_modules/.pnpm
