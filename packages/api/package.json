{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "tsc": "tsc --noEmit",
    "generate-openapi": "tsx src/generate.ts",
    "generate-openapi-watch": "node --watch --no-warnings --import tsx src/generate.ts",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore --list-different",
    "test": "jest --verbose --colors",
    "test:coverage": "jest --coverage"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.2",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "openapi3-ts": "^4.6.0",
    "prettier": "^3.8.4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "5.9.3"
  }
}
