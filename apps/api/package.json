{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:express --external:cors --external:helmet --external:@prisma/client",
    "clean": "rm -rf dist",
    "dev": "concurrently --restart-tries -1 --restart-after 3000 --color -n \"Build,TSC,API,OAS\" -c \"bgBlue.bold,bgCyan.bold,bgGreen.bold,bgYellow.bold\" \"pnpm build --watch\" \"tsc --noEmit --watch\" \"node --watch dist/index.js\" \"pnpm --filter @repo/api generate-openapi-watch\"",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "start": "node dist/index.js",
    "tsc": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore --list-different"
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "@repo/api": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "better-auth": "^1.6.11",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "multer": "^2.1.1",
    "prisma": "7.8.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "typescript": "5.9.3"
  }
}
