{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:express --external:morgan --external:cors --external:body-parser",
    "clean": "rm -rf dist",
    "dev": "tsx watch src/index.ts",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts*\" --max-warnings 0",
    "start": "node dist/index.js",
    "tsc": "tsc --noEmit",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@repo/logger": "workspace:*",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
