{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:express --external:cors --external:helmet --external:@prisma/client",
    "clean": "rm -rf dist",
    "dev": "pnpm --filter @repo/db generate && tsx watch --watch src --clear-screen=false src/index.ts",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "start": "node dist/index.js",
    "tsc": "tsc --noEmit",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore --list-different"
  },
  "jest": {
    "preset": "@repo/jest-presets/node"
  },
  "dependencies": {
    "@repo/api": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "better-auth": "^1.6.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
