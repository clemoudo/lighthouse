{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts src/scripts/*.ts --bundle --outdir=dist --platform=node --target=node24 --external:express --external:cors --external:helmet --external:@prisma/client",
    "clean": "rm -rf dist",
    "dev": "concurrently --restart-tries -1 --restart-after 3000 --color -n \"DB,Build,TSC,API,OAS\" -c \"magenta.bold,bgBlue.bold,bgCyan.bold,bgGreen.bold,bgYellow.bold\" \"pnpm --filter @repo/db db:generate-watch\" \"pnpm build --watch\" \"tsc --noEmit --watch\" \"nodemon --watch dist/index.js --delay 0.5 dist/index.js\" \"pnpm --filter @repo/api generate-openapi-watch\"",
    "lint": "eslint \"src/**/*.ts*\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "promote-admin": "node dist/scripts/promote-admin.js",
    "start": "node dist/index.js",
    "tsc": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore --list-different",
    "test": "NODE_ENV=test jest --verbose --colors",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^3.0.37",
    "@llamaindex/llama-cloud": "^2.9.0",
    "@prisma/client": "7.8.0",
    "@repo/api": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "ai": "^6.0.199",
    "better-auth": "^1.6.16",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-errors": "^2.0.1",
    "multer": "^2.1.1",
    "prisma": "7.8.0",
    "resend": "^6.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@repo/eslint-config": "workspace:*",
    "@repo/jest-presets": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.2",
    "@types/supertest": "^7.2.0",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "5.9.3"
  }
}
