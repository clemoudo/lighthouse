{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "concurrently --restart-tries -1 --restart-after 3000 --color -n \"Next,Orval\" -c \"bgBlack.bold,bgCyan.bold\" \"pnpm dev:next\" \"pnpm generate-api:watch\"",
    "dev:next": "unset NODE_OPTIONS && next dev",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "tsc": "tsc --noEmit",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "format": "prettier --write . --ignore-path ../../.prettierignore --list-different",
    "generate-api": "orval",
    "generate-api:watch": "orval --watch",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.193",
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@ant-design/plots": "^2.6.8",
    "@repo/api": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/logger": "workspace:*",
    "@tanstack/react-form": "^1.32.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.26",
    "ai": "^6.0.191",
    "antd": "^6.4.2",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.2.6",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/eslint-plugin-query": "^5.100.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "orval": "^8.13.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  }
}
